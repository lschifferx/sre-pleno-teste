{
  "version": "8.13.0",
  "objects": [
    {
      "id": "sre-demo-index-pattern",
      "type": "index-pattern",
      "attributes": {
        "title": "app-logs-*",
        "timeFieldName": "@timestamp"
      }
    },
    {
      "id": "sre-log-volume-by-level",
      "type": "visualization",
      "attributes": {
        "title": "Log Volume by Level",
        "visState": "{\"type\":\"pie\",\"params\":{\"addTooltip\":true,\"addLegend\":true,\"legendPosition\":\"right\",\"isDonut\":true},\"aggs\":[{\"id\":\"1\",\"type\":\"count\",\"schema\":\"metric\"},{\"id\":\"2\",\"type\":\"terms\",\"schema\":\"segment\",\"params\":{\"field\":\"log_level.keyword\",\"size\":5,\"order\":\"desc\",\"orderBy\":\"1\"}}]}",
        "uiStateJSON": "{}",
        "description": "Distribution of log levels INFO/WARN/ERROR",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": "{\"index\":\"sre-demo-index-pattern\",\"query\":{\"match_all\":{}},\"filter\":[]}"
        }
      }
    },
    {
      "id": "sre-top-endpoints",
      "type": "visualization",
      "attributes": {
        "title": "Top Endpoints",
        "visState": "{\"type\":\"table\",\"params\":{\"perPage\":10,\"showPartialRows\":false,\"showMetricsAtAllLevels\":false,\"sort\":{\"columnIndex\":null,\"direction\":null},\"showTotal\":false,\"totalFunc\":\"sum\"},\"aggs\":[{\"id\":\"1\",\"type\":\"count\",\"schema\":\"metric\"},{\"id\":\"2\",\"type\":\"terms\",\"schema\":\"bucket\",\"params\":{\"field\":\"endpoint.keyword\",\"size\":10,\"order\":\"desc\",\"orderBy\":\"1\"}}]}",
        "description": "Most accessed endpoints",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": "{\"index\":\"sre-demo-index-pattern\",\"query\":{\"match_all\":{}},\"filter\":[]}"
        }
      }
    },
    {
      "id": "sre-error-timeseries",
      "type": "visualization",
      "attributes": {
        "title": "Errors Over Time",
        "visState": "{\"type\":\"line\",\"params\":{\"addTooltip\":true,\"addLegend\":true,\"legendPosition\":\"bottom\",\"showCircles\":true},\"aggs\":[{\"id\":\"1\",\"type\":\"count\",\"schema\":\"metric\"},{\"id\":\"2\",\"type\":\"date_histogram\",\"schema\":\"segment\",\"params\":{\"field\":\"@timestamp\",\"interval\":\"auto\",\"min_doc_count\":1}}]}",
        "description": "Error log count over time",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": "{\"index\":\"sre-demo-index-pattern\",\"query\":{\"match\":{\"log_level\":\"ERROR\"}},\"filter\":[]}"
        }
      }
    },
    {
      "id": "sre-latency-histogram",
      "type": "visualization",
      "attributes": {
        "title": "Request Latency Distribution",
        "visState": "{\"type\":\"histogram\",\"params\":{\"addTooltip\":true,\"addLegend\":false,\"enableHover\":false,\"scale\":\"linear\",\"defaultYExtents\":false},\"aggs\":[{\"id\":\"1\",\"type\":\"count\",\"schema\":\"metric\"},{\"id\":\"2\",\"type\":\"histogram\",\"schema\":\"segment\",\"params\":{\"field\":\"latency_ms\",\"interval\":50,\"min_doc_count\":1}}]}",
        "description": "Distribution of request latencies in ms",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": "{\"index\":\"sre-demo-index-pattern\",\"query\":{\"match_all\":{}},\"filter\":[]}"
        }
      }
    },
    {
      "id": "sre-demo-dashboard",
      "type": "dashboard",
      "attributes": {
        "title": "SRE Demo — Log Analytics",
        "description": "Observability dashboard for sre-demo-app logs",
        "hits": 0,
        "timeRestore": true,
        "timeTo": "now",
        "timeFrom": "now-1h",
        "refreshInterval": {
          "pause": false,
          "value": 30000
        },
        "panelsJSON": "[{\"panelIndex\":\"1\",\"gridData\":{\"x\":0,\"y\":0,\"w\":12,\"h\":10,\"i\":\"1\"},\"embeddableConfig\":{},\"savedObjectId\":\"sre-log-volume-by-level\"},{\"panelIndex\":\"2\",\"gridData\":{\"x\":12,\"y\":0,\"w\":12,\"h\":10,\"i\":\"2\"},\"embeddableConfig\":{},\"savedObjectId\":\"sre-top-endpoints\"},{\"panelIndex\":\"3\",\"gridData\":{\"x\":0,\"y\":10,\"w\":24,\"h\":10,\"i\":\"3\"},\"embeddableConfig\":{},\"savedObjectId\":\"sre-error-timeseries\"},{\"panelIndex\":\"4\",\"gridData\":{\"x\":0,\"y\":20,\"w\":24,\"h\":10,\"i\":\"4\"},\"embeddableConfig\":{},\"savedObjectId\":\"sre-latency-histogram\"}]",
        "optionsJSON": "{\"useMargins\":true,\"syncColors\":false,\"hidePanelTitles\":false}",
        "kibanaSavedObjectMeta": {
          "searchSourceJSON": "{\"query\":{\"language\":\"kuery\",\"query\":\"\"},\"filter\":[]}"
        }
      }
    },
    {
      "id": "sre-error-alert-rule",
      "type": "alert",
      "attributes": {
        "name": "High Error Rate Alert — ≥20 errors in 5 min",
        "tags": [
          "sre",
          "error-rate"
        ],
        "alertTypeId": ".es-query",
        "consumer": "alerts",
        "schedule": {
          "interval": "1m"
        },
        "throttle": "15m",
        "notifyWhen": "onThrottleInterval",
        "enabled": true,
        "params": {
          "index": [
            "app-logs-*"
          ],
          "timeField": "@timestamp",
          "timeWindowSize": 5,
          "timeWindowUnit": "m",
          "thresholdComparator": ">=",
          "threshold": [
            20
          ],
          "esQuery": "{\"query\": {\"bool\": {\"must\": [{\"match\": {\"log_level\": \"ERROR\"}}, {\"bool\": {\"must_not\": [{\"terms\": {\"endpoint.keyword\": [\"/health\", \"/ready\", \"/metrics\"]}}]}}]}}}",
          "aggType": "count",
          "groupBy": "all",
          "termSize": 5,
          "termField": "endpoint.keyword",
          "searchConfiguration": {
            "query": {
              "query": "",
              "language": "kuery"
            }
          }
        },
        "actions": [
          {
            "group": "threshold met",
            "actionTypeId": ".index",
            "params": {
              "index": "sre-alerts",
              "refresh": true,
              "documents": [
                {
                  "alert_name": "{{rule.name}}",
                  "alert_id": "{{rule.id}}",
                  "triggered_at": "{{date}}",
                  "error_count": "{{context.value}}",
                  "message": "🚨 High error rate detected: {{context.value}} errors in the last 5 minutes (threshold: 20)"
                }
              ]
            }
          }
        ]
      },
      "references": []
    }
  ]
}